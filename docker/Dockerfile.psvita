# RuffleVita build image: VitaSDK + Rust "vita" nightly target + the native
# graphics/audio stack (SDL2 with the vitaGL backend, vitaShaRK, vitaGL),
# then a release build of ./emulator packaged as a VPK.
FROM ghcr.io/vita-rust/vitasdk-rs:latest

RUN apk add --no-cache \
        openjdk11 \
        cmake \
        samurai \
        git \
        bash \
        build-base

# The native libraries are pinned to the commits RuffleVita 1.2.0 was built
# with: vitaGL's master stopped building on 2026-10-11 (1a3b247, gxm.c uses
# pthread_create without including pthread.h), and a release shouldn't pick
# up graphics changes nobody tested.
ARG SDL_COMMIT=f99bb638f7eb256fa812e9da15d4e295a170640c
ARG VITASHARK_COMMIT=df24065e65098b2d1ac533760109ad4367573f28
ARG VITAGL_COMMIT=36f512ea80a9cdf9c01875ec163313bda7cd26b6

# --- Northfear's SDL2 fork with the VITA_VGL video backend -----------------
RUN git init -q /opt/SDL && cd /opt/SDL && \
    git fetch -q --depth=1 https://github.com/Northfear/SDL "$SDL_COMMIT" && \
    git checkout -q FETCH_HEAD && \
    cmake -S. -Bbuild \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_TOOLCHAIN_FILE=${VITASDK}/share/vita.toolchain.cmake \
        -DCMAKE_BUILD_TYPE=Release \
        -DVIDEO_VITA_VGL=ON \
        -G Ninja && \
    cmake --build build --parallel "$(nproc)" && \
    cmake --install build

# --- vitaShaRK (runtime shader compiler used by vitaGL) ---------------------
RUN git init -q /opt/vitaShaRK && cd /opt/vitaShaRK && \
    git fetch -q --depth=1 https://github.com/Rinnegatamante/vitaShaRK "$VITASHARK_COMMIT" && \
    git checkout -q FETCH_HEAD && \
    make install -j"$(nproc)"

# --- vitaGL -----------------------------------------------------------------
# HAVE_GLSL_SUPPORT: our shaders are GLSL ES 1.00 and must be translated.
# NO_DEBUG: drops per-call error checking/logging (a large CPU cost).
# NO_SPLASHSCREEN: no animated vitaGL logo at boot.
# The rest matches what ruffle4consoles was tuned and tested with.
RUN git init -q /opt/vitaGL && cd /opt/vitaGL && \
    git fetch -q --depth=1 https://github.com/Rinnegatamante/vitaGL "$VITAGL_COMMIT" && \
    git checkout -q FETCH_HEAD && \
    make NO_SPLASHSCREEN=1 HAVE_GLSL_SUPPORT=1 NO_DEBUG=1 PRIMITIVES_SPEEDHACK=1 CIRCULAR_VERTEX_POOL=2 \
         USE_SCRATCH_MEMORY=1 HAVE_CUSTOM_HEAP=1 HAVE_PTHREAD=1 install -j"$(nproc)"

# --- RuffleVita --------------------------------------------------------------
COPY emulator /opt/rufflevita
WORKDIR /opt/rufflevita
ARG RUFFLEVITA_FEATURES=""

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/opt/rufflevita/target \
    RUFFLEVITA_FEATURES="$RUFFLEVITA_FEATURES" ./build_psp2.sh && \
    mkdir -p /out && \
    cp target/armv7-sony-vita-newlibeabihf/vita/rufflevita.vpk /out/ && \
    cp target/armv7-sony-vita-newlibeabihf/vita/rufflevita.self /out/

CMD ["sh", "-c", "cp -v /out/* /dist/"]
